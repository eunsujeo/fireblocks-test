# 로컬 개발용 환경변수 템플릿. scripts/local.sh가 .env를 자동 생성한다.
# .env는 gitignore 대상이며 이 파일에는 절대 실값을 넣지 않는다.

# --- DB (로컬 postgres 컨테이너 — README '빌드/실행' 참조) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:15432/bcm
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=bcm

# --- Kafka (scripts/local.sh가 로컬 컨테이너를 기동) ---
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# --- HTTP 수신 (가상 스레드 사용 · 동시 연결 상한은 환경별 조정) ---
BCM_HTTP_MAX_CONNECTIONS=100

# --- Fireblocks Testnet workspace ---
BCM_FIREBLOCKS_BASE_URL=https://api.fireblocks.io
BCM_FIREBLOCKS_API_KEY=
BCM_FIREBLOCKS_PRIVATE_KEY_FILE=
FIREBLOCKS_JWKS_URL=https://keys.fireblocks.io/.well-known/jwks.json

# --- 로컬 실행 모드 ---
BCM_VENDOR_MODE=FIREBLOCKS
BCM_CHAIN_MODE=TESTNET
