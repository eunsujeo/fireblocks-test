[Unit]
Description=Blockchain Manager local Fireblocks Stub
After=bcm-local-anvil.service
Requires=bcm-local-anvil.service

[Service]
Type=simple
User=bcm-local
Group=bcm-local
EnvironmentFile=/etc/blockchain-manager-local/stub.env
WorkingDirectory=/var/lib/blockchain-manager-local
ExecStartPre=/opt/blockchain-manager-local/current/bin/bcm-local health-chain
ExecStart=/opt/blockchain-manager-local/current/jre/bin/java -jar /opt/blockchain-manager-local/current/lib/blockchain-manager-test-support.jar
ExecStartPost=/opt/blockchain-manager-local/current/bin/bcm-local health-stub
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/blockchain-manager-local

[Install]
WantedBy=multi-user.target
