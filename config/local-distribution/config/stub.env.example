# /etc/blockchain-manager-local/stub.env로 복사한 뒤 권한을 0600으로 설정한다.
BCM_VENDOR_MODE=STUB
BCM_CHAIN_MODE=LOCAL
BCM_STUB_ADDRESS=127.0.0.1
BCM_STUB_PORT=18080
BCM_STUB_MANAGEMENT_ADDRESS=127.0.0.1
BCM_STUB_MANAGEMENT_PORT=18090
BCM_FIREBLOCKS_BASE_URL=http://127.0.0.1:18080
BCM_FIREBLOCKS_API_KEY=bcm-local-stub
FIREBLOCKS_JWKS_URL=http://127.0.0.1:18080/.well-known/jwks.json
BCM_EVM_RPC_URL=http://127.0.0.1:8545
BCM_EVM_CHAIN_ID=31337
BCM_LOCAL_ANVIL_BINARY=/opt/blockchain-manager-local/current/bin/anvil
BCM_LOCAL_ANVIL_PORT=8545
BCM_LOCAL_CHAIN_SEED_FILE=/var/lib/blockchain-manager-local/chain.seed
BCM_LOCAL_CHAIN_RUNTIME_DIR=/var/lib/blockchain-manager-local/chain
BCM_LOCAL_CONTRACT_ARTIFACT_DIR=/opt/blockchain-manager-local/current/contracts
BCM_LOCAL_CHAIN_MANIFEST_FILE=/var/lib/blockchain-manager-local/chain/manifest.json
BCM_LOCAL_CHAIN_KEY_FILE=/var/lib/blockchain-manager-local/chain/evm-keys.json
BCM_STUB_RESET_ENABLED=true
